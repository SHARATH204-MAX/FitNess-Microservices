# Copy these values into your shell environment before starting the services.
# Replace placeholders locally; do not commit real credentials.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
